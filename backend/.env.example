# MongoDB Atlas connection string (include the database name).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/laundry_shop

# Use long random strings in production. Render can generate these for you.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Allowed CORS origins, comma-separated. Any *.vercel.app origin is also
# allowed automatically (see src/main.ts).
# Example: http://localhost:3001,https://laundry-shop.vercel.app
FRONTEND_URL=http://localhost:3001

# Image uploads. With this set, order/shop/rider photos go to Cloudinary and
# survive redeploys. Without it the app falls back to writing ./uploads on
# local disk, which Render wipes on every deploy and restart.
# Copy the "API environment variable" from your Cloudinary dashboard:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Forgot-password email (Gmail app password, not your account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# Render injects PORT automatically; this is only for local runs.
PORT=3000

# Build collections and unique indexes at startup. Leave unset (or true) for a
# new or empty database; set to false on an established one to skip the check.
MONGO_AUTO_INDEX=true
